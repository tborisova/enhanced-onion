<h1 class="text-2xl font-bold mb-6">New Category</h1>

<div class="bg-white shadow rounded-lg p-6 max-w-lg">
  <%= form_with model: [:admin, @category], class: 'space-y-4' do |f| %>
    <% if @category.errors.any? %>
      <div class="p-4 bg-red-100 text-red-800 rounded">
        <ul>
          <% @category.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: 'block text-sm font-medium text-gray-700' %>
      <%= f.text_field :name, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border' %>
    </div>

    <div class="flex items-center space-x-4">
      <%= f.submit 'Create Category', class: 'bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 cursor-pointer' %>
      <%= link_to 'Cancel', admin_categories_path, class: 'text-gray-600 hover:text-gray-900' %>
    </div>
  <% end %>
</div>
