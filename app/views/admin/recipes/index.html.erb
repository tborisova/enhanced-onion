<h1 class="text-2xl font-bold mb-6">Recipes</h1>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Image</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Title</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">User</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">URL</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @recipes.each do |recipe| %>
        <tr>
          <td class="px-6 py-4 text-sm">
            <% if recipe.photo.attached? %>
              <a href="#" onclick="document.getElementById('modal-<%= recipe.id %>').classList.remove('hidden'); return false;" class="text-indigo-600 hover:text-indigo-900">View</a>
            <% else %>
              <span class="text-gray-400">--</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm">
            <%= link_to recipe.title, admin_recipe_path(recipe), class: 'text-indigo-600 hover:text-indigo-900' %>
          </td>
          <td class="px-6 py-4 text-sm">
            <%= link_to recipe.user&.email, admin_user_path(recipe.user), class: 'text-indigo-600 hover:text-indigo-900' %>
          </td>
          <td class="px-6 py-4 text-sm">
            <% if recipe.url.present? %>
              <%= link_to recipe.url.truncate(30), recipe.url, target: '_blank', class: 'text-indigo-600 hover:text-indigo-900' %>
            <% else %>
              <span class="text-gray-400">--</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= recipe.time %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= recipe.created_at.strftime('%Y-%m-%d') %></td>
          <td class="px-6 py-4 text-sm">
            <%= button_to 'Delete', admin_recipe_path(recipe), method: :delete,
                  data: { confirm: 'Are you sure?' }, class: 'text-red-600 hover:text-red-900' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render 'admin/shared/pagination' %>

<% @recipes.each do |recipe| %>
  <% if recipe.photo.attached? %>
    <div id="modal-<%= recipe.id %>" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
         onclick="if(event.target===this) this.classList.add('hidden');">
      <div class="relative bg-white rounded-lg p-2 max-w-2xl max-h-[90vh]">
        <button onclick="this.closest('[id^=modal]').classList.add('hidden');" class="absolute top-3 right-3 bg-white rounded-full w-8 h-8 flex items-center justify-center shadow text-gray-600 hover:text-gray-900">&times;</button>
        <%= image_tag recipe.photo, class: 'max-w-full max-h-[85vh] rounded' %>
      </div>
    </div>
  <% end %>
<% end %>
