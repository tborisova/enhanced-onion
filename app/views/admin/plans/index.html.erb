<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Plans</h1>
  <%= link_to 'New Plan', new_admin_plan_path, class: 'bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700' %>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Free?</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Recipes Quota</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Images Quota</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @plans.each do |plan| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= plan.name %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= plan.price ? number_to_currency(plan.price) : 'N/A' %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= plan.is_free ? 'Yes' : 'No' %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= plan.recipes_quota %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= plan.images_quota %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to 'Edit', edit_admin_plan_path(plan), class: 'text-indigo-600 hover:text-indigo-900' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render 'admin/shared/pagination' %>
