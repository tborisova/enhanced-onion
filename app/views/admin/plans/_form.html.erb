<%= form_with model: @plan, url: @plan.persisted? ? admin_plan_path(@plan) : admin_plans_path, method: @plan.persisted? ? :patch : :post, class: 'space-y-4' do |f| %>
  <% if @plan.errors.any? %>
    <div class="p-4 bg-red-100 text-red-800 rounded">
      <ul>
        <% @plan.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-medium text-gray-700">Name</label>
    <%= f.text_field :name, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm border px-3 py-2 focus:border-indigo-500 focus:ring-indigo-500' %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700">Price</label>
    <%= f.number_field :price, step: 0.01, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm border px-3 py-2 focus:border-indigo-500 focus:ring-indigo-500' %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :is_free, class: 'rounded border-gray-300' %>
    <label class="text-sm font-medium text-gray-700">Free plan</label>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700">Recipes Quota</label>
    <%= f.number_field :recipes_quota, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm border px-3 py-2 focus:border-indigo-500 focus:ring-indigo-500' %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700">Images Quota</label>
    <%= f.number_field :images_quota, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm border px-3 py-2 focus:border-indigo-500 focus:ring-indigo-500' %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: 'bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 cursor-pointer' %>
    <%= link_to 'Cancel', admin_plans_path, class: 'py-2 px-4 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50' %>
  </div>
<% end %>
