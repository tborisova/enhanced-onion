<% if @pagy.pages > 1 %>
  <div class="mt-6">
    <style>
      .pagy.series-nav { display: flex; gap: 0.25rem; justify-content: center; align-items: center; }
      .pagy.series-nav a { padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; color: #4f46e5; text-decoration: none; border: 1px solid #e5e7eb; }
      .pagy.series-nav a:hover:not([aria-disabled]) { background-color: #eef2ff; }
      .pagy.series-nav a[aria-current="page"] { background-color: #4f46e5; color: white; border-color: #4f46e5; }
      .pagy.series-nav a[aria-disabled] { color: #9ca3af; cursor: default; }
    </style>
    <%= @pagy.series_nav.html_safe %>
  </div>
<% end %>
