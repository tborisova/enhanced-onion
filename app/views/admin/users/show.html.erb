<div class="mb-4">
  <%= link_to '&larr; Back to Users'.html_safe, admin_users_path, class: 'text-indigo-600 hover:text-indigo-900' %>
</div>

<div class="bg-white shadow rounded-lg p-6 mb-8">
  <h1 class="text-2xl font-bold mb-4"><%= @user.email %></h1>
  <dl class="grid grid-cols-2 gap-4">
    <div>
      <dt class="text-sm font-medium text-gray-500">Name</dt>
      <dd class="text-sm text-gray-900"><%= @user.name || 'N/A' %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Plan</dt>
      <dd class="text-sm text-gray-900"><%= @user.plan&.name || 'None' %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd class="text-sm">
        <% if @user.suspended %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Suspended</span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Admin</dt>
      <dd class="text-sm text-gray-900"><%= @user.admin? ? 'Yes' : 'No' %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Created</dt>
      <dd class="text-sm text-gray-900"><%= @user.created_at.strftime('%Y-%m-%d %H:%M') %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Recipes</dt>
      <dd class="text-sm text-gray-900"><%= @recipes.count %></dd>
    </div>
  </dl>
</div>

<h2 class="text-xl font-bold mb-4">Recipes</h2>
<% if @recipes.any? %>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @recipes.each do |recipe| %>
          <tr>
            <td class="px-6 py-4 text-sm">
              <%= link_to recipe.title, admin_recipe_path(recipe), class: 'text-indigo-600 hover:text-indigo-900' %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= recipe.time %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= recipe.created_at.strftime('%Y-%m-%d') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-500">No recipes yet.</p>
<% end %>
