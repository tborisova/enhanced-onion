<h1 class="text-2xl font-bold mb-6">Users</h1>

<%= form_tag admin_users_path, method: :get, class: 'mb-6' do %>
  <div class="flex gap-2">
    <input type="text" name="search" value="<%= params[:search] %>" placeholder="Search by email..."
           class="rounded-md border-gray-300 shadow-sm border px-3 py-2 flex-1 focus:border-indigo-500 focus:ring-indigo-500">
    <button type="submit" class="bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700">Search</button>
  </div>
<% end %>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Plan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @users.each do |user| %>
        <tr>
          <td class="px-6 py-4 text-sm text-gray-900"><%= user.id %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to user.email, admin_user_path(user), class: 'text-indigo-600 hover:text-indigo-900' %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-900"><%= user.name %></td>
          <td class="px-6 py-4 text-sm">
            <%= form_tag admin_user_path(user), method: :patch do %>
              <select name="plan_id" onchange="this.form.submit()" class="rounded border-gray-300 text-sm border px-2 py-1">
                <% @plans.each do |plan| %>
                  <option value="<%= plan.id %>" <%= 'selected' if user.plan_id == plan.id %>><%= plan.name %></option>
                <% end %>
              </select>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm">
            <% if user.suspended %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Suspended</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= user.created_at.strftime('%Y-%m-%d') %></td>
          <td class="px-6 py-4 text-sm">
            <% if user.suspended %>
              <%= button_to 'Unsuspend', admin_user_path(user, unsuspend: true), method: :patch, class: 'text-green-600 hover:text-green-900' %>
            <% else %>
              <%= button_to 'Suspend', admin_user_path(user, suspend: true), method: :patch,
                    data: { confirm: 'Are you sure?' }, class: 'text-red-600 hover:text-red-900' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render 'admin/shared/pagination' %>
