<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Dietary Preferences</h1>
  <%= link_to 'New Dietary Preference', new_admin_dietary_preference_path, class: 'bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700' %>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @dietary_preferences.each do |dietary_preference| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= dietary_preference.name %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to 'Edit', edit_admin_dietary_preference_path(dietary_preference), class: 'text-indigo-600 hover:text-indigo-900' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render 'admin/shared/pagination' %>
