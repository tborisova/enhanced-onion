<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Temporary Images</h1>
</div>

<% if @temporary_images.any? %>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Image</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">User</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @temporary_images.each do |temp_image| %>
          <tr>
            <td class="px-6 py-4 text-sm text-gray-900"><%= temp_image.id %></td>
            <td class="px-6 py-4 text-sm">
              <% if temp_image.image.attached? %>
                <%= image_tag temp_image.image, class: 'h-16 w-16 object-cover rounded' %>
              <% else %>
                <span class="text-gray-400">No image</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <% if temp_image.user %>
                <%= link_to temp_image.user.email, admin_user_path(temp_image.user), class: 'text-indigo-600 hover:text-indigo-900' %>
              <% else %>
                <span class="text-gray-400">No user</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= temp_image.created_at.strftime('%Y-%m-%d %H:%M') %></td>
            <td class="px-6 py-4 text-sm">
              <%= button_to 'Delete', admin_temporary_image_path(temp_image), method: :delete, class: 'text-red-600 hover:text-red-900', data: { confirm: 'Are you sure?' } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render 'admin/shared/pagination' %>
<% else %>
  <div class="bg-white shadow rounded-lg p-6 text-gray-500">No temporary images found.</div>
<% end %>
