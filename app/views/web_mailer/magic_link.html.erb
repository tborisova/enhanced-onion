<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #1a1a1a; max-width: 520px; margin: 0 auto; padding: 24px; line-height: 1.5;">
  <p style="font-size: 16px;">Hi<%= @user.name.present? ? " #{@user.name}" : '' %>,</p>

  <p style="font-size: 16px;">Click the button below to sign in to Curry on Mars on the web.</p>

  <p style="margin: 32px 0;">
    <a href="<%= @login_url %>"
       style="display: inline-block; background-color: #d64545; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-size: 16px; font-weight: 600;">
      Sign in to Curry on Mars
    </a>
  </p>

  <p style="font-size: 14px; color: #555;">
    If the button doesn't work, copy and paste this link into your browser:
  </p>

  <p style="font-size: 13px; word-break: break-all; color: #555;">
    <a href="<%= @login_url %>" style="color: #555;"><%= @login_url %></a>
  </p>

  <p style="font-size: 14px; color: #555; margin-top: 24px;">This link expires in 15 minutes.</p>

  <p style="font-size: 14px; color: #555;">If you didn't request this, you can safely ignore this email.</p>
</div>
