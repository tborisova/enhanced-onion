<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curry on Mars</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            curry: {
              orange: '#ED744D',
              'orange-light': '#f08c6a',
              maroon: '#480D2A',
              'maroon-dark': '#400F29',
              cream: '#FFF5E6',
              'cream-dark': '#FDEDDD',
              peach: '#ffd5bb',
            }
          }
        }
      }
    }
  </script>
  <%= csrf_meta_tags %>
</head>
<body class="bg-curry-cream min-h-screen relative">
  <div class="fixed inset-0 z-0" style="background-image: url('/background-texture.png'); background-size: 400px; background-repeat: repeat; opacity: 0.08;"></div>
  <div class="relative z-10 min-h-screen">
  <% if session[:web_user_id] %>
    <nav class="bg-curry-maroon shadow-lg">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center space-x-6">
            <%= link_to web_recipes_path, class: 'flex items-center space-x-2' do %>
              <span class="text-xl font-bold text-curry-cream">Curry on Mars</span>
            <% end %>
          </div>
          <div class="flex items-center space-x-4">
            <span class="text-curry-peach text-sm"><%= User.find_by(id: session[:web_user_id])&.email %></span>
            <%= button_to 'Log out', web_logout_path, method: :delete, class: 'text-curry-cream hover:text-curry-orange text-sm font-medium transition' %>
          </div>
        </div>
      </div>
    </nav>
  <% end %>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <% if flash[:notice] %>
      <div class="mb-6 p-4 bg-green-100 text-green-800 rounded-lg text-sm"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-6 p-4 bg-red-100 text-red-800 rounded-lg text-sm"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </div>
  </div>
</body>
</html>
