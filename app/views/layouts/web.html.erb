<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curry on Mars</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            burgundy: '#400F29',
            'burgundy-soft': '#5A1A3A',
            cream: '#FDEDDD',
            'cream-light': '#FFF5E6',
            peach: '#FFDBD1',
            'peach-soft': '#FFD5BB',
            clay: '#775749',
            'clay-light': '#A08C84',
            ink: '#201B19',
          },
          fontFamily: {
            display: ['"Kalam"', '"Caveat"', 'cursive'],
            body: ['"Nunito"', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: "Nunito", ui-sans-serif, system-ui, sans-serif; }
    h1, h2, h3 { font-family: "Kalam", "Caveat", cursive; letter-spacing: 0.01em; }
  </style>
  <%= csrf_meta_tags %>
</head>
<body class="bg-cream min-h-screen text-ink antialiased relative">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-peach-soft/60 blur-3xl"></div>
    <div class="absolute top-80 -right-32 h-[28rem] w-[28rem] rounded-full bg-peach/50 blur-3xl"></div>
  </div>

  <% if session[:web_user_id] %>
    <header class="sticky top-0 z-40 bg-cream/85 backdrop-blur border-b border-peach-soft/60">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
        <%= link_to root_path, class: 'group' do %>
          <span class="font-display text-2xl text-burgundy leading-none group-hover:text-burgundy-soft transition">Curry on Mars</span>
        <% end %>
        <div class="flex items-center gap-4">
          <span class="hidden sm:inline text-sm text-clay"><%= User.find_by(id: session[:web_user_id])&.email %></span>
          <%= button_to 'Log out', logout_path, method: :delete, form: { class: 'inline' }, class: 'rounded-full border border-burgundy/30 text-burgundy text-sm font-semibold px-4 py-1.5 hover:bg-burgundy hover:text-cream-light transition' %>
        </div>
      </div>
    </header>
  <% end %>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <% if flash[:notice] %>
      <div class="mb-6 px-4 py-3 rounded-2xl bg-peach/60 text-burgundy text-sm border border-peach-soft/60"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-6 px-4 py-3 rounded-2xl bg-red-50 text-red-800 text-sm border border-red-200"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </div>

  <style>
    .zoom-overlay {
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.9);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999; cursor: zoom-out;
    }
    .zoom-overlay img {
      max-width: 100%; max-height: 100%; object-fit: contain;
      touch-action: pinch-zoom; transition: transform 0.2s;
      cursor: zoom-in;
    }
    .zoom-overlay img.zoomed { cursor: zoom-out; }
  </style>
  <script>
    (function () {
      document.addEventListener('click', function (e) {
        var target = e.target.closest && e.target.closest('[data-zoomable]');
        if (!target || document.querySelector('.zoom-overlay')) return;
        e.preventDefault();
        var overlay = document.createElement('div');
        overlay.className = 'zoom-overlay';
        var img = document.createElement('img');
        img.src = target.currentSrc || target.src;
        img.alt = target.alt || '';
        overlay.appendChild(img);
        document.body.appendChild(overlay);
        document.body.style.overflow = 'hidden';

        function close() {
          if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
          document.body.style.overflow = '';
          document.removeEventListener('keydown', onKey);
        }
        function onKey(ev) { if (ev.key === 'Escape') close(); }
        document.addEventListener('keydown', onKey);

        overlay.addEventListener('click', function (ev) {
          if (ev.target === overlay) close();
        });
        img.addEventListener('click', function (ev) {
          ev.stopPropagation();
          if (img.classList.contains('zoomed')) {
            img.style.transform = '';
            img.style.transformOrigin = '';
            img.classList.remove('zoomed');
          } else {
            var rect = img.getBoundingClientRect();
            var x = ((ev.clientX - rect.left) / rect.width) * 100;
            var y = ((ev.clientY - rect.top) / rect.height) * 100;
            img.style.transformOrigin = x + '% ' + y + '%';
            img.style.transform = 'scale(2)';
            img.classList.add('zoomed');
          }
        });
      });
    })();
  </script>
</body>
</html>
