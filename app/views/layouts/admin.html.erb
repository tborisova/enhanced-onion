<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Curry on Mars</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <%= csrf_meta_tags %>
</head>
<body class="bg-gray-50 min-h-screen">
  <% if session[:admin_user_id] %>
    <nav class="bg-white shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center space-x-8">
            <span class="text-lg font-bold text-gray-900">Admin</span>
            <%= link_to 'Users', admin_users_path, class: 'text-gray-600 hover:text-gray-900' %>
            <%= link_to 'Plans', admin_plans_path, class: 'text-gray-600 hover:text-gray-900' %>
            <%= link_to 'Recipes', admin_recipes_path, class: 'text-gray-600 hover:text-gray-900' %>
            <%= link_to 'Categories', admin_categories_path, class: 'text-gray-600 hover:text-gray-900' %>
          </div>
          <div>
            <%= button_to 'Logout', admin_logout_path, method: :delete, class: 'text-gray-600 hover:text-gray-900' %>
          </div>
        </div>
      </div>
    </nav>
  <% end %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <% if flash[:notice] %>
      <div class="mb-4 p-4 bg-green-100 text-green-800 rounded"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-red-100 text-red-800 rounded"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </div>
  <script>
    document.addEventListener('submit', function(e) {
      var btn = e.target.querySelector('button[data-confirm]');
      if (btn && !confirm(btn.getAttribute('data-confirm'))) {
        e.preventDefault();
      }
    });
  </script>
</body>
</html>
