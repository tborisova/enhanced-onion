<div class="max-w-md mx-auto mt-20">
  <div class="bg-white rounded-2xl shadow-lg p-8">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-curry-maroon">Curry on Mars</h1>
      <p class="text-curry-maroon/60 mt-2">Sign in to view your recipes</p>
    </div>

    <%= form_tag web_login_path, method: :post, class: 'space-y-5' do %>
      <div>
        <label for="email" class="block text-sm font-medium text-curry-maroon mb-1">Email</label>
        <input type="email" name="email" id="email" required placeholder="you@example.com"
               class="block w-full rounded-lg border border-curry-peach bg-curry-cream px-4 py-3 text-curry-maroon placeholder-curry-maroon/40 focus:border-curry-orange focus:ring-2 focus:ring-curry-orange/20 focus:outline-none transition">
      </div>
      <button type="submit" class="w-full bg-curry-orange text-white py-3 px-4 rounded-lg font-semibold hover:bg-curry-orange-light transition shadow-md">
        Send Magic Link
      </button>
    <% end %>

    <% if @apple_sign_in_enabled %>
      <div class="flex items-center my-6">
        <div class="flex-1 border-t border-curry-peach"></div>
        <span class="px-3 text-xs text-curry-maroon/50 uppercase tracking-wider">or</span>
        <div class="flex-1 border-t border-curry-peach"></div>
      </div>

      <div id="appleid-signin" class="flex justify-center"
           data-color="black"
           data-border="true"
           data-type="sign-in"
           data-mode="center-align"
           data-border-radius="8"
           data-width="320"
           data-height="48"></div>

      <script type="text/javascript"
              src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js"></script>
      <script>
        AppleID.auth.init({
          clientId: '<%= j @apple_client_id %>',
          scope: 'name email',
          redirectURI: '<%= j @apple_redirect_uri %>',
          state: '<%= j @apple_state %>',
          responseMode: 'form_post',
          responseType: 'code id_token',
          usePopup: false
        });
      </script>
    <% end %>
  </div>
</div>
