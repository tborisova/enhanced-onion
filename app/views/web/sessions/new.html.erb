<div class="max-w-md mx-auto mt-16">
  <div class="text-center mb-8">
    <h1 class="font-display text-5xl text-burgundy">Curry on Mars</h1>
    <p class="mt-2 text-clay">Sign in to view your recipes.</p>
  </div>

  <div class="bg-cream-light rounded-3xl shadow-xl shadow-burgundy/5 p-8 border border-peach-soft/60">
    <%= form_tag sign_in_path, method: :post, class: 'space-y-5' do %>
      <div>
        <label for="email" class="block text-xs uppercase tracking-widest text-clay mb-2">Email</label>
        <input type="email" name="email" id="email" required placeholder="you@kitchen.com"
               class="block w-full rounded-full border border-peach-soft bg-cream px-5 py-3 text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition">
      </div>
      <button type="submit" class="w-full rounded-full bg-burgundy text-cream-light py-3 px-4 font-semibold hover:bg-burgundy-soft transition shadow-lg shadow-burgundy/20">
        Sign in with email
      </button>
    <% end %>

    <% if @apple_sign_in_enabled %>
      <div class="flex items-center my-6">
        <div class="flex-1 border-t border-peach-soft"></div>
        <span class="px-3 text-xs text-clay uppercase tracking-widest">or</span>
        <div class="flex-1 border-t border-peach-soft"></div>
      </div>

      <div id="appleid-signin" class="flex justify-center"
           data-color="black"
           data-border="true"
           data-type="sign-in"
           data-mode="center-align"
           data-border-radius="50"
           data-width="320"
           data-height="48"></div>

      <script type="text/javascript"
              src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js"></script>
      <script>
        AppleID.auth.init({
          clientId: '<%= j @apple_client_id %>',
          scope: 'name email',
          redirectURI: '<%= j @apple_redirect_uri %>',
          state: '<%= j @apple_state %>',
          responseMode: 'form_post',
          responseType: 'code id_token',
          usePopup: false
        });
      </script>
    <% end %>
  </div>
</div>
