<div class="max-w-md mx-auto mt-20">
  <div class="bg-white rounded-2xl shadow-lg p-8">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-curry-maroon">Create your account</h1>
      <p class="text-curry-maroon/60 mt-2">Join Curry on Mars to save your recipes</p>
    </div>

    <%= form_tag web_register_path, method: :post, class: 'space-y-5' do %>
      <div>
        <label for="name" class="block text-sm font-medium text-curry-maroon mb-1">Name</label>
        <input type="text" name="name" id="name" value="<%= @name %>" placeholder="Your name"
               class="block w-full rounded-lg border border-curry-peach bg-curry-cream px-4 py-3 text-curry-maroon placeholder-curry-maroon/40 focus:border-curry-orange focus:ring-2 focus:ring-curry-orange/20 focus:outline-none transition">
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-curry-maroon mb-1">Email</label>
        <input type="email" name="email" id="email" value="<%= @email %>" required placeholder="you@example.com"
               class="block w-full rounded-lg border border-curry-peach bg-curry-cream px-4 py-3 text-curry-maroon placeholder-curry-maroon/40 focus:border-curry-orange focus:ring-2 focus:ring-curry-orange/20 focus:outline-none transition">
      </div>
      <button type="submit" class="w-full bg-curry-orange text-white py-3 px-4 rounded-lg font-semibold hover:bg-curry-orange-light transition shadow-md">
        Sign up
      </button>
    <% end %>

    <%= render 'web/shared/apple_sign_in' %>

    <p class="text-center text-sm text-curry-maroon/60 mt-6">
      Already have an account?
      <%= link_to 'Sign in', web_login_path, class: 'text-curry-orange hover:underline font-medium' %>
    </p>
  </div>
</div>
