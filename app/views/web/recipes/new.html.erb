<% if @mode.nil? %>
  <div class="max-w-3xl mx-auto">
    <%= link_to recipes_path, class: 'inline-flex items-center gap-1 text-sm font-semibold text-clay hover:text-burgundy transition' do %>
      <span aria-hidden="true">&larr;</span> Back to recipes
    <% end %>

    <h1 class="mt-4 font-display text-5xl text-burgundy">Add a new recipe</h1>
    <p class="mt-2 text-clay">Choose how you'd like to start.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <%= link_to new_recipe_path(mode: 'photo'), class: 'group block rounded-3xl bg-cream-light border border-peach-soft/60 p-6 hover:shadow-xl hover:-translate-y-1 transition' do %>
        <div class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-peach-soft/60 mb-4">
          <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 16.5V8.25A2.25 2.25 0 015.25 6H7.5l1.5-2.25h6L16.5 6h2.25A2.25 2.25 0 0121 8.25v8.25A2.25 2.25 0 0118.75 18.75H5.25A2.25 2.25 0 013 16.5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z"/>
          </svg>
        </div>
        <h2 class="text-2xl text-burgundy group-hover:text-burgundy-soft transition">Upload a photo</h2>
        <p class="mt-2 text-sm text-clay">Save a snapshot of a recipe you want to remember.</p>
      <% end %>

      <%= link_to new_recipe_path(mode: 'manual'), class: 'group block rounded-3xl bg-cream-light border border-peach-soft/60 p-6 hover:shadow-xl hover:-translate-y-1 transition' do %>
        <div class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-peach-soft/60 mb-4">
          <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125"/>
          </svg>
        </div>
        <h2 class="text-2xl text-burgundy group-hover:text-burgundy-soft transition">Add manually</h2>
        <p class="mt-2 text-sm text-clay">Write the title, ingredients, and instructions yourself.</p>
      <% end %>

      <%= link_to new_recipe_path(mode: 'link'), class: 'group block rounded-3xl bg-cream-light border border-peach-soft/60 p-6 hover:shadow-xl hover:-translate-y-1 transition' do %>
        <div class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-peach-soft/60 mb-4">
          <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
          </svg>
        </div>
        <h2 class="text-2xl text-burgundy group-hover:text-burgundy-soft transition">Save a link</h2>
        <p class="mt-2 text-sm text-clay">Bookmark a recipe from anywhere on the web.</p>
      <% end %>
    </div>
  </div>
<% else %>
  <% mode_titles = { 'photo' => 'Add a recipe from a photo', 'manual' => 'Add a recipe manually', 'link' => 'Save a recipe from a link' } %>
  <% mode_blurbs = {
       'photo' => 'Upload an image of your recipe.',
       'manual' => 'Write down the recipe however you like.',
       'link' => 'Paste a link to the recipe you want to save.'
     } %>
  <% dietary_options = [%w[meat Meat], %w[vegetarian Vegetarian], %w[vegan Vegan]] %>

  <div class="max-w-3xl mx-auto">
    <%= link_to new_recipe_path, class: 'inline-flex items-center gap-1 text-sm font-semibold text-clay hover:text-burgundy transition' do %>
      <span aria-hidden="true">&larr;</span> Choose a different way
    <% end %>

    <h1 class="mt-4 font-display text-5xl text-burgundy"><%= mode_titles[@mode] %></h1>
    <p class="mt-2 text-clay"><%= mode_blurbs[@mode] %></p>

    <%= form_with url: recipes_path(mode: @mode), method: :post, multipart: true, local: true, scope: :recipe, html: { class: 'mt-8 space-y-6' } do |f| %>

      <% if @mode == 'photo' %>
        <div class="rounded-3xl bg-cream-light border border-peach-soft/60 p-6">
          <label class="block text-xs uppercase tracking-widest text-clay mb-3">Photo</label>
          <%= f.file_field :photo, accept: 'image/jpeg,image/png,image/webp,image/heic,image/heif', required: true, class: 'block w-full text-sm text-ink file:mr-4 file:py-2 file:px-5 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-burgundy file:text-cream-light hover:file:bg-burgundy-soft cursor-pointer' %>
          <p class="mt-2 text-xs text-clay-light">JPEG, PNG, WebP, or HEIC — up to 10 MB.</p>
        </div>
      <% end %>

      <% if @mode == 'link' %>
        <div>
          <label class="block text-xs uppercase tracking-widest text-clay mb-2">Link</label>
          <%= f.url_field :url, value: @form['url'], placeholder: 'https://…', required: true,
                class: 'block w-full rounded-full border border-peach-soft bg-cream px-4 py-2 text-sm text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition' %>
        </div>
      <% end %>

      <div>
        <label class="block text-xs uppercase tracking-widest text-clay mb-2">Title</label>
        <%= f.text_field :title, value: @form['title'], required: true, placeholder: 'Give it a name',
              class: 'block w-full rounded-full border border-peach-soft bg-cream px-4 py-2 text-sm text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition' %>
      </div>

      <% if @mode == 'manual' %>
        <div id="ingredients-block">
          <label class="block text-xs uppercase tracking-widest text-clay mb-3">Ingredients</label>
          <div id="ingredients-rows" class="space-y-2">
            <% Array(@form['ingredients']).each do |row| %>
              <div class="ingredient-row flex gap-2">
                <input type="text" name="recipe[ingredients][][name]" value="<%= row['name'] || row[:name] %>" placeholder="Ingredient"
                       class="flex-1 rounded-full border border-peach-soft bg-cream px-4 py-2 text-sm text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition">
                <input type="text" name="recipe[ingredients][][quantity]" value="<%= row['quantity'] || row[:quantity] %>" placeholder="Quantity"
                       class="w-40 rounded-full border border-peach-soft bg-cream px-4 py-2 text-sm text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition">
                <button type="button" data-remove-ingredient class="text-clay hover:text-burgundy px-2" aria-label="Remove ingredient">&times;</button>
              </div>
            <% end %>
          </div>
          <template id="ingredient-template">
            <div class="ingredient-row flex gap-2">
              <input type="text" name="recipe[ingredients][][name]" placeholder="Ingredient"
                     class="flex-1 rounded-full border border-peach-soft bg-cream px-4 py-2 text-sm text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition">
              <input type="text" name="recipe[ingredients][][quantity]" placeholder="Quantity"
                     class="w-40 rounded-full border border-peach-soft bg-cream px-4 py-2 text-sm text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition">
              <button type="button" data-remove-ingredient class="text-clay hover:text-burgundy px-2" aria-label="Remove ingredient">&times;</button>
            </div>
          </template>
          <button type="button" id="add-ingredient" class="mt-3 inline-flex items-center gap-1 rounded-full bg-peach text-burgundy px-4 py-1.5 text-sm font-semibold hover:bg-peach-soft transition">
            <span aria-hidden="true">+</span> Add ingredient
          </button>
        </div>

        <div>
          <label class="block text-xs uppercase tracking-widest text-clay mb-2">Instructions</label>
          <%= f.text_area :description, value: @form['description'], rows: 6, required: true, placeholder: 'Step by step, however you like…',
                class: 'block w-full rounded-2xl border border-peach-soft bg-cream px-4 py-3 text-sm text-burgundy placeholder-clay-light focus:border-burgundy focus:ring-2 focus:ring-peach focus:outline-none transition' %>
        </div>
      <% end %>

      <div>
        <label class="block text-xs uppercase tracking-widest text-clay mb-3">Category</label>
        <div class="flex flex-wrap gap-2">
          <% @categories.each do |cat| %>
            <label class="cursor-pointer">
              <input type="radio" name="recipe[category_id]" value="<%= cat.id %>" class="peer sr-only" required
                     <%= 'checked' if @form['category_id'].to_s == cat.id.to_s %>>
              <span class="inline-block rounded-full border border-peach-soft bg-cream px-4 py-1.5 text-sm font-semibold text-burgundy peer-checked:bg-peach peer-checked:border-peach transition">
                <%= cat.name.capitalize %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <div>
        <label class="block text-xs uppercase tracking-widest text-clay mb-3">Dietary preference</label>
        <div class="flex flex-wrap gap-2">
          <% dietary_options.each do |value, label_text| %>
            <label class="cursor-pointer">
              <input type="radio" name="recipe[dietary_preference]" value="<%= value %>" class="peer sr-only" required
                     <%= 'checked' if @form['dietary_preference'].to_s == value %>>
              <span class="inline-block rounded-full border border-peach-soft bg-cream px-4 py-1.5 text-sm font-semibold text-burgundy peer-checked:bg-burgundy peer-checked:text-cream-light peer-checked:border-burgundy transition">
                <%= label_text %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <%= f.submit 'Save recipe', class: 'rounded-full bg-burgundy text-cream-light px-6 py-2.5 text-sm font-semibold hover:bg-burgundy-soft transition shadow-md shadow-burgundy/20 cursor-pointer' %>
        <%= link_to 'Cancel', recipes_path, class: 'rounded-full text-clay hover:text-burgundy px-4 py-2 text-sm font-semibold transition' %>
      </div>
    <% end %>
  </div>

  <% if @mode == 'manual' %>
    <script>
      (function () {
        var addBtn = document.getElementById('add-ingredient');
        var rows = document.getElementById('ingredients-rows');
        var tpl = document.getElementById('ingredient-template');
        if (!addBtn || !rows || !tpl) return;

        function ensureAtLeastOne() {
          if (rows.children.length === 0) {
            rows.appendChild(tpl.content.firstElementChild.cloneNode(true));
          }
        }

        addBtn.addEventListener('click', function () {
          rows.appendChild(tpl.content.firstElementChild.cloneNode(true));
        });

        rows.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-remove-ingredient]');
          if (!btn) return;
          var row = btn.closest('.ingredient-row');
          if (row) row.remove();
          ensureAtLeastOne();
        });

        ensureAtLeastOne();
      })();
    </script>
  <% end %>
<% end %>
