<div class="max-w-3xl mx-auto">
  <%= link_to recipes_path, class: 'inline-flex items-center gap-1 text-sm font-semibold text-clay hover:text-burgundy transition' do %>
    <span aria-hidden="true">&larr;</span> Back to recipes
  <% end %>

  <% if @recipe.photo.attached? %>
    <div class="mt-6 rounded-3xl overflow-hidden bg-peach-soft/40 border border-peach-soft/80">
      <%= image_tag @recipe.photo, class: 'w-full object-cover cursor-zoom-in max-h-[420px]', alt: "Photo of #{@recipe.title}", data: { zoomable: true } %>
    </div>
  <% end %>

  <div class="mt-6 flex flex-wrap gap-2">
    <% if @recipe.dietary_preference %>
      <span class="rounded-full bg-peach px-3 py-1 text-xs font-semibold text-burgundy uppercase tracking-wider">
        <%= @recipe.dietary_preference.name.capitalize %>
      </span>
    <% end %>
    <% @recipe.categories.each do |cat| %>
      <span class="rounded-full bg-peach-soft/60 px-3 py-1 text-xs font-semibold text-burgundy uppercase tracking-wider">
        <%= cat.name.capitalize %>
      </span>
    <% end %>
    <% if @recipe.time.present? %>
      <span class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-clay inline-flex items-center gap-1 border border-peach-soft/60">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <%= @recipe.time %>
      </span>
    <% end %>
  </div>

  <h1 class="mt-4 text-5xl text-burgundy leading-tight"><%= @recipe.title %></h1>
  <p class="mt-3 text-sm text-clay">Added on <%= @recipe.created_at.strftime('%B %-d, %Y') %></p>

  <% if @recipe.url.present? %>
    <div class="mt-6 p-4 rounded-2xl bg-cream border border-peach-soft/60">
      <p class="text-xs uppercase tracking-widest text-clay">Source</p>
      <%= link_to @recipe.url.truncate(60), @recipe.url, target: '_blank', rel: 'noopener', class: 'mt-1 inline-block text-burgundy hover:text-burgundy-soft font-semibold break-all transition underline decoration-peach hover:decoration-burgundy' %>
    </div>
  <% end %>

  <% has_ingredients = @recipe.recipe_ingredients.any? %>
  <% has_description = @recipe.description.present? %>

  <% if has_ingredients || has_description %>
    <div class="mt-12 grid gap-10 md:grid-cols-5">
      <% if has_ingredients %>
        <div class="<%= has_description ? 'md:col-span-2' : 'md:col-span-5' %>">
          <div class="rounded-3xl bg-peach-soft/40 p-6 border border-peach-soft/80">
            <h2 class="text-2xl text-burgundy">Ingredients</h2>
            <ul class="mt-4 space-y-2">
              <% @recipe.recipe_ingredients.includes(:ingredient).each do |ri| %>
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-1.5 w-1.5 rounded-full bg-burgundy shrink-0"></span>
                  <span class="text-ink/90">
                    <strong class="text-burgundy"><%= ri.ingredient.name %></strong><%= " — #{ri.quantity}" if ri.quantity.present? %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <% if has_description %>
        <div class="<%= has_ingredients ? 'md:col-span-3' : 'md:col-span-5' %>">
          <h2 class="text-2xl text-burgundy">Description</h2>
          <p class="mt-4 text-ink/90 leading-relaxed whitespace-pre-line"><%= @recipe.description %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
